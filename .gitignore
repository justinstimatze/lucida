.env
.venv/
__pycache__/
*.pyc
.ruff_cache/
dist/
build/
*.egg-info/

# external tool state
.defn/

# generated artifacts that aren't seed/placeholder
.nano_banana_usage.json
cells/cell-*.png
cells/cell-*.jpg
cells/cell-*.webp
# Persistent mermaid SVG cache (#152d). Regenerated on demand; bumping
# STYLE_V invalidates a generation. ~400 files / ~30KB each, not source.
cells/cell-*.mermaid.*.svg
cells/*.mermaid.*.svg

# transcript watcher state files
.watcher_state_*.json

# runtime mint log — append-only by orchestrator, read by recent_mints hook
mint_log.jsonl

# user cell data — each user generates their own from their own conversations
cells.json
cells.json.bak*
cells.json.before-*
cells.json.pre-*
cells.json.corrupt-*
cells.json.tmp
cells.json.lock*
cells.json.truncated-*
cells_*_archive.json
# Old-snapshot quarantine — orchestrator writes timestamped backups before
# destructive operations (cull, rebalance, sysmetric resampling); accumulates
# 100s of MB over months. tools/cleanup_cells_snapshots.py moves stale ones
# here on demand; deletes are the user's call.
.cells-snapshots/
tools/.system_metrics_state.json
tools/.system_metrics_state.tmp

# plancheck MCP debug spill — overwritten every plan check; never source
.plancheck-debug.json

# scratch notes / drafts not for the repo
VR.md

# audit outputs are local — contain snippets from real conversations
audits/

# Claude Code project settings — personal paths, not for contributors
.claude/

# stray screenshots / pastes
Pasted image*.png
Pasted image*.jpg

# generated demo artifacts — run demo/make_demo_cells.py to recreate
demo/demo_cells.json

# local-only research scrapes/exhaustive surveys — not committed.
# Curated synthesis with bookmarks lives in design-references.md (committed);
# raw per-entry tables and competitor URL surveys live here for local lookup.
research/

# Visual reference dumps — ephemeral QA outputs (live-shots) and
# Reference stills — ALL copyrighted frames under refs/ stay local-only
# (re-extractable from sources via yt-dlp+ffmpeg; methodology + curation
# verdicts live in the per-dir NOTES.md, which ARE tracked, along with
# refs/ATTRIBUTION.md).  Pattern-based after the 2026-06-09 audit found
# 131 stills tracked across 17 dirs despite the per-dir ignore list.
refs/**
!refs/*/
!refs/**/
!refs/**/NOTES.md
!refs/ATTRIBUTION.md

# memory dir leaked from auto-memory hook — actual store lives under
# ~/.claude/projects/.../memory/, not in the project repo.
memory/

# node deps for mermaid lint+fix (validate_mermaid.mjs). package.json
# is committed; node_modules + lock are regenerable via npm install.
node_modules/
package-lock.json
