{
  "name": "lucida-mermaid-lint",
  "version": "1.0.0",
  "private": true,
  "description": "node deps for validate_mermaid.mjs — mermaid lint+fix gate invoked by orchestrator.py before persisting mermaid cells",
  "type": "commonjs",
  "scripts": {
    "validate": "node validate_mermaid.mjs",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "typecheck": "tsc -p jsconfig.json",
    "test:motion": "node tools/test_motion.mjs"
  },
  "dependencies": {
    "jsdom": "^29.1.1",
    "mermaid": "10.9.6",
    "puppeteer": "^25.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "gsap": "3.15.0",
    "typescript": "~5.6"
  }
}
