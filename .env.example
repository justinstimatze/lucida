# Copy to .env and fill in. .env is gitignored.

# Required for any LLM-driven cell generation.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if using the image substrate (--type image).
# Install image extras first: uv pip install -e .[image]
# GOOGLE_API_KEY=AIza...

# --- Optional tuning knobs (all have sensible defaults; uncomment to override) ---

# Model overrides per stage. All default to claude-sonnet-4-6. Useful for
# cost/quality experimentation -- but note the classifier was trialed on
# haiku 2026-06-10 and rejected (36% cell_type agreement, half the sample
# collapsed to suppressed text; see classifier.py DEFAULT_MODEL comment and
# tools/classifier_agreement_check.py before retrying that).
#LUCIDA_CLASSIFIER_MODEL=claude-sonnet-4-6

# Classifier prompt-cache TTL: "1h" (default) or "5m". 1h survives
# conversation lulls; 5m is marginally cheaper only if your sessions
# never pause more than 5 minutes.
#LUCIDA_CLASSIFIER_CACHE_TTL=1h
#LUCIDA_SEGMENTER_MODEL=claude-sonnet-4-6
#LUCIDA_SPECIALIST_MODEL=claude-sonnet-4-6
#LUCIDA_IMAGE_SPECIALIST_MODEL=claude-sonnet-4-6
#LUCIDA_EVALUATOR_MODEL=claude-sonnet-4-6
#LUCIDA_TEXT_EVALUATOR_MODEL=claude-sonnet-4-6
#LUCIDA_REFLECT_MODEL=claude-sonnet-4-6
#NANO_BANANA_MODEL=gemini-2.5-flash-image

# Rolling cap on cells.json. "0" / "all" / "none" / "off" disables the cap
# so the file accumulates as a long-running archive. Default 200.
#LUCIDA_MAX_CELLS=200

# Reflection cadence in the --watch loop. 0 = no reflection cells minted
# (default — saves cost). Set to e.g. 25 to mint a synthesis cell every
# 25 new cells.
#LUCIDA_WATCHER_REFLECT_EVERY=0

# Cap on image generations per day (nano-banana / Gemini image). Sidecar-
# tracked. Default 200.
#LUCIDA_DAILY_IMAGE_CAP=200

# Retrigger (auto-regenerate a cell when the evaluator flags it low quality).
# Floor: skip retrigger if score below this (cell is hopeless). Ceiling:
# skip if score above (already good enough). USE_I2I=1 falls back to
# image-to-image retry on failure.
#LUCIDA_RETRIGGER_USE_I2I=1
#LUCIDA_RETRIGGER_SCORE_FLOOR=0.5
#LUCIDA_RETRIGGER_SCORE_CEILING=0.8
