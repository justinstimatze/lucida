# Copy to .env and fill in. .env is gitignored.

# Google AI Studio API key — billing must be enabled on the project
# (image generation is excluded from the free tier).
GOOGLE_API_KEY=

# Anthropic API key — used by the orchestrator's classifier and by the
# vega/mermaid/html spec specialists once they land (v0.5+). Not read by
# the v0 keyword classifier; staged here so it's obvious where it goes.
ANTHROPIC_API_KEY=

# Default nano banana model. Options:
#   gemini-2.5-flash-image          (~$0.039/image, fast — default)
#   gemini-3.1-flash-image-preview  (~$0.045/image, 4K)
#   gemini-3-pro-image-preview      (~$0.134/image, best reasoning)
NANO_BANANA_MODEL=gemini-2.5-flash-image

# Optional: hard ceiling on images generated per day (safety net).
# Tracked in .nano_banana_usage.json, keyed by UTC date.
LUCIDA_DAILY_IMAGE_CAP=200
